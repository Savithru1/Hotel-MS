# Copy to `.env` and fill in. Never commit `.env`.
# The backend validates these at startup (added in P1.2) and refuses to start if a required
# secret is empty. There are no fallback secrets.

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# MongoDB is the only database. This points at the one-node replica set from docker-compose.yml
# (replicaSet=rs0 is required for transactions).
MONGODB_URI=mongodb://127.0.0.1:27017/hospitality_platform?replicaSet=rs0

# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Browser origins allowed to call the API (staff app, guest app dev servers).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Added in later sub-phases when needed:
#   P1.13  RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET, RAZORPAY_WEBHOOK_SECRET
# (No Google Maps or LLM keys: those belong to Phase 2.)
