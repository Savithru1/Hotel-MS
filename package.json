{
  "name": "hospitality-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Hotel management system (hospitality platform). MongoDB is the only database.",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tsconfig.json",
    "test": "pnpm -r test && vitest run",
    "db:up": "docker compose up -d --wait mongo",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait mongo",
    "db:logs": "docker compose logs -f mongo"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.2"
  }
}
